{
  "compilerOptions": {
    "allowJs": false,
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@features/*": ["src/features/*"],
      "@shared/*": ["src/shared-ui/*"],
      "@domain/*": ["src/domain/*"],
      "@data/*": ["src/data/*"]
    }
  },
  "include": ["App.tsx", "src/**/*"]
}


