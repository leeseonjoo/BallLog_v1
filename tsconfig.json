{
  "compilerOptions": {
    "allowJs": false,
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@mvvn/*": ["src/mvvn/*"]
    }
  },
  "include": ["App.tsx", "src/**/*"]
}
